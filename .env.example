# --- Database (Neon: use the *pooled* connection string, ends in -pooler) ---
DATABASE_URL=postgres://postgres@localhost:5432/taskmanager

# --- Security ---
# 32+ random chars:  openssl rand -hex 32
SESSION_SECRET=
# 32 bytes base64:   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Random string for cron-job.org:  openssl rand -hex 24
CRON_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=olucasbernardino@gmail.com

# --- App ---
# Public URL of the app. Local dev with Vite proxy: http://localhost:5173
APP_URL=http://localhost:5173
# Local only. Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN=true
